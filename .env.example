# Este archivo documenta las variables usadas por compose.yaml.
# Cada servicio también tiene su propio .env.example dentro de su carpeta.

# MongoDB
MONGODB_URI=mongodb://mongodb:27017/beatstore

# main-api
JWT_SECRET=change_this_value_before_deploy
JWT_EXPIRES_IN=8h
INVENTORY_API_BASE_URL=http://inventory-api:8001

# frontend
VITE_API_URL=http://localhost:3000/api/v1
