# Application
NODE_ENV=development
APP_NAME=BeatStore Main API
PORT=3000

# Public API
API_PREFIX=api
API_VERSION=1

# Frontend
CORS_ORIGINS=http://localhost:5173

# Internal inventory service
INVENTORY_API_BASE_URL=http://inventory-api:8001
INVENTORY_API_TIMEOUT_MS=5000
INVENTORY_API_RETRY_COUNT=2
# MongoDB
MONGODB_URI=mongodb://mongodb:27017/beatstore

# JWT
JWT_SECRET=change_this_value_before_deploy
JWT_EXPIRES_IN=8h
